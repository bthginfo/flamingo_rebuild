# Copy to .env.local for local development (never commit .env.local).

# --- Rebuild database (required for persistence APIs) ---
# Create a dedicated Neon project or branch for flamingo-rebuild only.
FLAMINGO_REBUILD_DB=1
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# For Drizzle CLI migrations from your machine, the pooled URL usually works.
# If migrate hangs, try Neon’s direct (non-pooling) connection string.

# --- Internal CRM (optional; hidden URL /internal/crm) ---
# Bcrypt hash of a strong password (min 8 chars). Generate e.g. with:
# node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
# FLAMINGO_INTERNAL_CRM_PASSWORD_HASH=

# --- Optional: eigenes Vercel-Projekt pro Tenant (nur Plattform-Deployment) ---
# Benötigt VERCEL_TOKEN + VERCEL_TEAM_ID + Plaintext POSTGRES_URL auf der Plattform.
# FLAMINGO_PROVISION_VERCEL=1
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# GitHub-Repo für neue Projekte (Default: bthginfo/flamingo_rebuild)
# GITHUB_REPO=

# --- Single-Tenant (automatisch auf Kunden-Vercel gesetzt; auf Plattform weglassen) ---
# FLAMINGO_SINGLE_TENANT_SLUG=

# --- Admin session signing ---
AUTH_SECRET=replace-with-a-long-random-string

# --- Vercel Blob (optional; required for /admin/media client upload) ---
# Create a Blob store in the Vercel project and copy the read-write token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Optional: host-based tenant routing (local dev) ---
# When set to 1, requests to {slug}{FLAMINGO_TENANT_HOST_SUFFIX} are rewritten to /site/{slug}/...
# Example: acme.localhost:3000 → /site/acme/...
# FLAMINGO_TENANT_HOST_ROUTING=1
# FLAMINGO_TENANT_HOST_SUFFIX=.localhost
